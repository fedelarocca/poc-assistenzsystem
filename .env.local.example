# Supabase Configuration for PoC
# Copy this file to .env.local and replace placeholders with your actual project keys
# HINWEIS: .env.local darf niemals in Git eingecheckt werden!

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
