# Supabase Configuration for PoC
# Copy this file to .env.local and replace placeholders with your actual project keys
# HINWEIS: .env.local darf niemals in Git eingecheckt werden!

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# KI-Analyse Einstellungen (Vercel AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key
OPENAI_API_KEY=your_openai_api_key
AI_PROVIDER=google
AI_MODEL=gemini-3.1-flash-lite

